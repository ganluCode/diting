# ── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://your-neo4j-host:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_HTTP_PORT=7474

# 默认项目（工具调用未传 project 时的兜底，留空=查全部）
DEFAULT_PROJECT=

# 代码工作区根目录 — 所有项目 source_path 的默认基准
# 项目 source_path 为相对路径时 → 拼接此目录；为绝对路径时（/ 开头）→ 直接使用
DITING_WORKSPACE=/path/to/your/workspace

# Git 私有仓库 Token（可选）— 克隆 HTTPS 私有仓库时按 host 注入
# SSH URL（git@xxx.com:...）使用 ~/.ssh/id_rsa，不需要在此配置
GITHUB_TOKEN=
GITEE_TOKEN=
GITLAB_TOKEN=

# ── LLM / NL2Cypher（可选，启用后支持自然语言查图）────────────────────────────
NL2CYPHER_ENABLED=false

# 方案 A：OpenAI 兼容接口（MiniMax / DeepSeek / 月之暗面等）
LLM_API_TYPE=openai
LLM_API_KEY=your_api_key_here
LLM_MODEL=MiniMax-Text-01
LLM_BASE_URL=https://api.minimaxi.chat/v1

# 方案 B：Anthropic 兼容接口（官方或兼容代理）
# LLM_API_TYPE=anthropic
# LLM_API_KEY=your_anthropic_key_here
# LLM_MODEL=claude-haiku-4-5-20251001
# LLM_BASE_URL=                          # 留空=官方 api.anthropic.com

# ── PostgreSQL（可选，用于摘要缓存 / 死代码分析 / 审计日志）────────────────────
PG_ENABLED=false
PG_HOST=your-pg-host
PG_PORT=5432
PG_USER=analyst
PG_PASSWORD=your_pg_password
PG_DATABASE=code_analysis
# Docker 模式（PG_HOST 留空时，通过 docker exec 连接）
PG_CONTAINER=postgres

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=                               # 静态 API Key，留空则不启用认证（请求 header: X-API-Key）

# ── MCP Server ────────────────────────────────────────────────────────────────
MCP_TRANSPORT=stdio       # stdio（本地/Claude Desktop）| sse（Docker/远程）
MCP_HOST=0.0.0.0
MCP_PORT=8001

# ── Java Scanner ──────────────────────────────────────────────────────────────
JQASSISTANT_VERSION=2.3.0
